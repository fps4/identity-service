{
  "name": "@fps4/identity-service-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "bundle:smoke": "node scripts/bundle-smoke.mjs",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --output-reproducible --output-file bundle/service.cdx.json && cyclonedx-npm --omit dev --output-format JSON --output-reproducible --output-file bundle/backup.cdx.json && cyclonedx-npm --omit dev --output-format JSON --output-reproducible --output-file bundle/relay.cdx.json",
    "typecheck:lambda": "tsc -p tsconfig.lambda.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "manage-users": "tsx scripts/manage-users.ts",
    "mcp": "LOG_DESTINATION=stderr tsx src/mcp/server.ts",
    "seed": "tsx scripts/seed.ts",
    "dump-seed": "tsx scripts/dump-seed.ts",
    "backup:decrypt": "tsx lambda/backup-decrypt.ts",
    "test": "vitest",
    "db:create": "tsx src/db/create-table.ts",
    "backup:restore": "tsx lambda/backup-restore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/lib-dynamodb": "^3.1136.0",
    "@fps4/maestro-spine": "^0.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.2.4",
    "pino": "^9.0.0",
    "pino-pretty": "^11.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11",
    "yaml": "^2.4.0"
  },
  "engines": {
    "node": ">=22.14"
  }
}
